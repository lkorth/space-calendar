{
  "name": "space-calendar",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "generate-zip-latitudes": "tsx scripts/generate-zip-latitudes.ts",
    "pipeline": "tsx src/pipeline/run.ts",
    "pipeline:monthly": "tsx src/pipeline/run.ts --schedule monthly",
    "pipeline:weekly": "tsx src/pipeline/run.ts --schedule weekly",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy --var DEPLOY_ID:$(git rev-parse --short HEAD)",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.pipeline.json --noEmit && tsc -p tsconfig.worker.json --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240405.0",
    "@types/node": "^25.8.0",
    "fflate": "^0.8.2",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.6",
    "wrangler": "^4.105.0",
    "yaml": "^2.4.0"
  }
}
