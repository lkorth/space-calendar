{
  "name": "space-calendar",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "generate-zip-latitudes": "tsx scripts/generate-zip-latitudes.ts",
    "pipeline": "tsx src/pipeline/run.ts",
    "pipeline:monthly": "tsx src/pipeline/run.ts --schedule monthly",
    "pipeline:weekly": "tsx src/pipeline/run.ts --schedule weekly",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy --var DEPLOY_ID:$(git rev-parse --short HEAD)",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.pipeline.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "generate-wall-calendar-font": "tsx scripts/generate-wall-calendar-font.ts",
    "wall-calendar": "tsx scripts/wall-calendar.ts",
    "build:site": "esbuild src/shared/wall-calendar/browser.ts --bundle --minify --format=esm --target=es2022 --outfile=src/site/wall-calendar.js"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260902.1",
    "@fontsource/jost": "^5.3.0",
    "@types/node": "^25.8.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.2",
    "opentype.js": "^2.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.155.0",
    "yaml": "^2.4.0"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  }
}
