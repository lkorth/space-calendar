{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "npm test 1>&2 || echo '{\"continue\": false, \"stopReason\": \"Tests failed — fix failing tests before committing.\"}'",
            "timeout": 120,
            "statusMessage": "Running tests before commit..."
          }
        ]
      }
    ]
  }
}
